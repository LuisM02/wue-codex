WUE_APP_NAME=WUE API
WUE_APP_VERSION=0.20.0
WUE_ENVIRONMENT=development
WUE_API_V1_PREFIX=/api/v1
WUE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wue_codex_db
WUE_UPLOAD_DIRECTORY=uploads
WUE_MAX_IMAGE_BYTES=10485760
WUE_MAX_IMAGE_PIXELS=40000000
WUE_CLASSIFICATION_PROVIDER=unconfigured
WUE_CLASSIFICATION_SERVICE_URL=http://127.0.0.1:8010
WUE_CLASSIFICATION_TIMEOUT_SECONDS=120
WUE_RECONSTRUCTION_PROVIDER=unconfigured
WUE_RECONSTRUCTION_SERVICE_URL=http://127.0.0.1:8010
WUE_RECONSTRUCTION_TIMEOUT_SECONDS=600

# Used only by tests marked "integration". Keep real credentials in .env.
WUE_TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wue_codex_test_db
