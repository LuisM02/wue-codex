WUE_APP_NAME=WUE API
WUE_APP_VERSION=0.2.0
WUE_ENVIRONMENT=development
WUE_API_V1_PREFIX=/api/v1
WUE_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wue_codex_db

# Used only by tests marked "integration". Keep real credentials in .env.
WUE_TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/wue_codex_test_db
